{
  "name": "madam-afaf",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "./node_modules/.bin/tsx server.ts",
    "start": "NODE_ENV=production ./node_modules/.bin/tsx server.ts",
    "build": "vite build",
    "check:bundle": "vite build && node -e \"const fs=require('fs'),path=require('path');const dir='dist/assets';const files=fs.readdirSync(dir).filter(f=>f.endsWith('.js'));for(const f of files){const c=fs.readFileSync(path.join(dir,f),'utf8');for(const bad of ['process.cwd','dotenv','node:fs','firestore.googleapis.com','identitytoolkit.googleapis.com','firebase-applet-config']){if(c.includes(bad)){console.error('Forbidden token '+bad+' in '+f);process.exit(1);}}}console.log('check:bundle OK ('+files.length+' assets verified)');\"",
    "preview": "vite preview",
    "test": "NODE_ENV=test ./node_modules/.bin/tsx --test src/**/*.test.ts",
    "config:check": "./node_modules/.bin/tsx src/lib/config-check.ts",
    "gold:export": "./node_modules/.bin/tsx scripts/gold-export.ts",
    "feedback:report": "./node_modules/.bin/tsx scripts/feedback-report.ts",
    "preflight": "./node_modules/.bin/tsx scripts/preflight.ts",
    "smoke": "./node_modules/.bin/tsx scripts/smoke.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-html-parser": "^9.0.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tldts": "^7.4.19",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
