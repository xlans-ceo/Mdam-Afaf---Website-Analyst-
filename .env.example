# ==============================================================================
# MADAM AFAF (مدام عفاف) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# AI Model Configuration (Google Gemini only; server-side)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"
AI_ENABLED="true"

# Application Hosting & Runtime
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"
SCAN_MODE="live"
TRUST_PROXY_HOPS=0

# Visitor Identity Hashing & Quota (Single Source of Truth in src/config/limits.server.ts)
# IMPORTANT: In production (NODE_ENV=production), VISITOR_ID_SALT MUST be >= 32 characters
# or the server refuses to start. Changing VISITOR_ID_SALT later will orphan every stored
# private report and per-(visitor, domain) quota record because visitor hashes change.
VISITOR_ID_SALT="replace_with_random_32_plus_char_secret_in_production"

# Scanner Concurrency & Quota Overrides (Read only by src/config/limits.server.ts)
MAX_CONCURRENT_SCANS_GLOBAL=5
MAX_CONCURRENT_SCANS_PER_IP=2
ECOMMERCE_MAX_PAGES=10
RESCAN_SAME_PAGES_FREE="false"
FREE_SCANS_HARD_DISABLED="false"

# Google PageSpeed Insights v5 API (Server-side only)
PSI_API_KEY=""
PSI_TIMEOUT_S=25
